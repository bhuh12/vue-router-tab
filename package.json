{
  "name": "vue-router-tab",
  "version": "2.0.0-alpha.0",
  "description": "Vue 3 tab components, based on Vue Router",
  "keywords": [
    "router-tab",
    "tabs",
    "vue-router-tab",
    "vue3"
  ],
  "bugs": {
    "url": "https://github.com/bhuh12/vue-router-tab/issues"
  },
  "license": "MIT",
  "author": "碧海幽虹 <bhuh12@126.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bhuh12/vue-router-tab.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dist/*": "./dist/*"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "stylelint": "stylelint \"src/**/*.{scss,vue}\"",
    "test": "vp test",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && pnpm --filter vue-router-tab-demo typecheck",
    "verify": "pnpm check && pnpm stylelint && pnpm test && pnpm build && pnpm demo:build && pnpm typecheck",
    "changelog": "conventional-changelog -p angular -i docs/guide/changelog.md -s",
    "prepublishOnly": "pnpm verify",
    "demo:dev": "pnpm --filter vue-router-tab-demo dev",
    "demo:build": "pnpm --filter vue-router-tab-demo build",
    "docs:dev": "pnpm --filter vue-router-tab-docs dev",
    "docs:build": "pnpm --filter vue-router-tab-docs build",
    "docs:preview": "pnpm --filter vue-router-tab-docs preview"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "conventional-changelog-cli": "^5.0.0",
    "happy-dom": "^20.11.1",
    "sass-embedded": "^1.100.0",
    "stylelint": "^17.14.1",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "^5.9.3",
    "unplugin-vue": "^7.2.0",
    "vite": "^8.2.0",
    "vite-plus": "^0.2.7",
    "vitest": "^4.1.10",
    "vue": "^3.5.0",
    "vue-router": "^5.2.0",
    "vue-tsc": "^3.3.8"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "vue-router": "^4 || ^5"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.20.0",
      "onFail": "download"
    }
  },
  "prepare": "vp config"
}
